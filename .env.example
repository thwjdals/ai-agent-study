# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다.

# 로컬 모델 (OpenAI 호환 엔드포인트)
# Ollama: brew services start ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
# LM Studio: 앱에서 Developer → Start Server (MLX 모델 비교용, 3주)
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# 기본 실습 모델 (ollama pull 로 받아 둔 것)
MODEL_STRONG=gpt-oss:20b
MODEL_WEAK=gemma3:12b
MODEL_EMBED=embeddinggemma

# 클라우드 비교용 (필요해지면 채운다)
ANTHROPIC_API_KEY=
